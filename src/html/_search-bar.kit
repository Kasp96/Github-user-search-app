<div class="search-box d-flex align-items-center position-relative z-0">
    <img class="search-img px-2 px-md-4" src="/images/icon-search.svg" alt="">
    <input class="search-input w-100" type="search" placeholder="Search GitHub username">
    <p class="error position-absolute z-n1">No results</p>
    <button class="search-btn">Search</button>
</div>