<div class="user-panel px-4">
    <div class="user-top d-flex align-items-center">
        <img class="rat" src="../images/rat.png" alt="">
        <div class="basic-info d-flex flex-column gap-2">
            <h2 class="github-name">The Octocat</h2>
            <h3 class="github-link">@octocat</h3>
            <p class="date-joined">Joined 25 Jan 2011</p>
        </div>
    </div>
    <p class="user-info">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Illum, animi.</p>
    <div class="user-stats d-flex justify-content-evenly">
        <div class="d-flex flex-column align-items-center gap-2">
            <h4>Repos</h4>
            <p class="amount">8</p>
        </div>
        <div class="d-flex flex-column align-items-center gap-2">
            <h4>Followers</h4>
            <p class="amount">3938</p>
        </div>
        <div class="d-flex flex-column align-items-center gap-2">
            <h4>Following</h4>
            <p class="amount">9</p>
        </div>
    </div>
    <div class="links d-flex flex-column gap-3">
        <div class="d-flex align-items-center gap-3">
            <div>
                <img src="../images/icon-location.svg" alt="location logo">
            </div>
            <p class="link-description">San Francisko</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div><img src="../images/icon-website.svg" alt="location logo">
            </div>
            <p class="link-description">https://github.blog</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div><img src="../images/icon-twitter.svg" alt="location logo">
            </div>
            <p class="link-description">Not Available</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div><img src="../images/icon-company.svg" alt="location logo">
            </div>
            <p class="link-description">@github</p>
        </div>
    </div>
</div>